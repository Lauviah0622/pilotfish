{
  "name": "pilotfish-vscode",
  "displayName": "pilotfish-vscode",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pilotfish-vscode.helloWorld",
        "title": "PilotFish: Hello World"
      },
      {
        "command": "pilotfish-vscode.insertAgentBlock",
        "title": "PilotFish: Insert Agent Block"
      },
      {
        "command": "pilotfish-vscode.makeAgentCommand",
        "title": "PilotFish: Copy agent instuction"
      }
    ],
    "configuration": {
      "title": "PilotFish",
      "properties": {
        "pilotfish-vscode.copyPathPrefix": {
          "type": "string",
          "default": "collab ",
          "description": "Prefix prepended to the path:line string produced by 'Copy Path with Line Number'."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "vscode:package": "pnpm exec vsce package --out pilotfish-vscode.vsix",
    "vscode:local-install": "pnpm run vscode:package && code --install-extension pilotfish-vscode.vsix --force",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-unit": "node -e \"require('node:fs').rmSync('dist/test', { recursive: true, force: true })\" && tsc -p tsconfig.test.json",
    "watch:unit": "tsc -p tsconfig.test.json -w",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm run test:unit",
    "test:integration": "vscode-test",
    "test:unit": "pnpm run compile-unit && node --test \"dist/test/**/*.test.js\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  }
}
