{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vscode: watch",
      "dependsOn": [
        "vscode: watch:tsc",
        "vscode: watch:esbuild"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "vscode: watch:esbuild",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "watch:esbuild"],
      "options": {
        "cwd": "${workspaceFolder}/apps/vscode"
      },
      "problemMatcher": "$esbuild-watch",
      "isBackground": true,
      "presentation": {
        "group": "vscode-watch",
        "reveal": "never"
      }
    },
    {
      "label": "vscode: watch:tsc",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "watch:tsc"],
      "options": {
        "cwd": "${workspaceFolder}/apps/vscode"
      },
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "group": "vscode-watch",
        "reveal": "never"
      }
    }
  ]
}
